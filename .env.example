# ==============================================================================
# PROJECT SYNTHEXIS - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your keys
# ==============================================================================

# Google Gemini API Key (Required for Person 4: llm_agent.py)
GEMINI_API_KEY=your_gemini_api_key_here

# FastAPI Backend Settings (Person 1: main_api.py)
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# Streamlit Frontend Settings (Person 1: app.py)
STREAMLIT_PORT=8501
SYNTHEXIS_API_URL=http://127.0.0.1:8000

# Hybrid Vector & Storage Settings (Person 3: vector_engine.py)
CHROMA_PERSIST_DIR=./data/chromadb
DEFAULT_TOP_K=5

# Document Upload & Cache Settings
UPLOAD_DIR=./data/uploads
EXTRACTED_IMAGES_DIR=./data/extracted_images
